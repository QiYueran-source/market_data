# 第三方 API token / 密码等（按实际使用的源填写）

# ---------- SMTP 发信（utils.emails.send_email）----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# 465 端口或 SMTP_USE_SSL=true 时使用 SSL；587 默认 STARTTLS
# SMTP_USE_SSL=false
# SMTP_STARTTLS=true
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# 默认收件人可选，调用 send_email 时也可传入 to_email
# TO_EMAILS=
